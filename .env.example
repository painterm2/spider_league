# Required for real spider judging. Without it the site runs in demo mode
# (canned verdicts, clearly labeled) so you can try the flow first.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: connect your Printful store to the Merch tab.
# Create a private token at https://developers.printful.com
# PRINTFUL_API_KEY=

# Optional overrides
# PORT=3000
# SPIDER_MODEL=claude-opus-4-8
# SPIDER_DATA_DIR=./data
